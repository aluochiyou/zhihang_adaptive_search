# Zhihang V6.7.19 portable machine profile
# Copy this file to machine_profile.env and edit it, or run:
#   bash configure_portable_machine.sh --model "$HOME/yolo_models/best.pt"
#
# Do not use sudo. Paths may contain spaces when quoted.

# ---------- ROS / workspace ----------
export ZHIHANG_WS="$HOME/xtdrone_competition_ws"
export ZHIHANG_ROS_SETUP="/opt/ros/noetic/setup.bash"
export ZHIHANG_OPTIONAL_UNDERLAY="$HOME/catkin_ws/devel/setup.bash"
# Official competition custom message workspace.
export ZHIHANG_MESSAGE_WS_SETUP="$HOME/zhihang_ws/devel/setup.bash"

# ---------- PX4 / XTDrone ----------
export ZHIHANG_XTDRONE_ROOT="$HOME/XTDrone"
export ZHIHANG_PX4_ROOT="$HOME/PX4_Firmware"
export ZHIHANG_PX4_ROS_PACKAGE="px4"
export ZHIHANG_PX4_LAUNCH_FILE="auto"
export ZHIHANG_PX4_LAUNCH_ARGS=""
# Set only when the PX4 environment is not already configured in ~/.bashrc.
export ZHIHANG_PX4_ENV_SCRIPT=""

export ZHIHANG_GUARD_ROS_PACKAGE="zhihang_xtdrone_guard"
export ZHIHANG_GUARD_LAUNCH_FILE="guard_standard_vtol.launch"
export ZHIHANG_POSE_SCRIPT="$HOME/XTDrone/sensing/pose_ground_truth/get_multi_vehcle_local_pose.sh"
export ZHIHANG_MODEL_STATE_SCRIPT="$HOME/XTDrone/zhihang2026/model_state.py"
export ZHIHANG_COMPETITION_DATA_DIR="$HOME/XTDrone/zhihang2026"

# ---------- Terminal / QGroundControl ----------
# auto selects gnome-terminal, xterm, konsole, then tmux.
export ZHIHANG_TERMINAL_BACKEND="auto"
export ZHIHANG_TMUX_SESSION="zhihang_v6_7_19"
export ZHIHANG_HEADLESS="0"
export ZHIHANG_START_QGC="1"
export ZHIHANG_QGC_EXECUTABLE="$HOME/software/QGC/QGroundControl(1).AppImage"
export ZHIHANG_QGC_ARGS=""

# ---------- YOLO runtime ----------
# auto / conda / venv / system / direct
export ZHIHANG_YOLO_RUNTIME="conda"
export ZHIHANG_YOLO_ENV="yolo26"
export ZHIHANG_YOLO_VENV="$HOME/.venvs/yolo26"
export ZHIHANG_YOLO_PYTHON=""
export ZHIHANG_YOLO_MODEL="$HOME/yolo_models/best.pt"

# Formal competition mode normally requires CUDA. Set 0 only after the real
# three-camera pipeline has demonstrated >=10 Hz on this computer.
export ZHIHANG_YOLO_REQUIRE_CUDA="1"
# One value per aircraft. Examples: 0,0,0 or 0,1,1 or cpu,cpu,cpu.
export ZHIHANG_YOLO_DEVICES="auto,auto,auto"
export ZHIHANG_YOLO_QUANTIZE="16"
export ZHIHANG_YOLO_ADAPTIVE="1"
export ZHIHANG_YOLO_ADAPTIVE_SIZES="640,512,416"
export ZHIHANG_YOLO_MINIMUM_FPS="10.0"
export ZHIHANG_YOLO_CONFIDENCE="0.25"
export ZHIHANG_YOLO_IOU="0.70"
export ZHIHANG_YOLO_WARMUP_ITERATIONS="3"

# Local workers are the normal same-computer configuration.
export ZHIHANG_YOLO_START_LOCAL_WORKERS="1"
export ZHIHANG_YOLO_HOSTS="127.0.0.1,127.0.0.1,127.0.0.1"
export ZHIHANG_YOLO_BIND_HOST="127.0.0.1"
export ZHIHANG_YOLO_PORT_BASE="17771"

# ---------- Mission defaults ----------
export ZHIHANG_DEFAULT_SCENE="scene_001_adaptive_v6_7_19_formal"
export ZHIHANG_DEFAULT_SEED="-1"
export ZHIHANG_RECORD_BAG="1"
